# Square Application Credentials (Sandbox by default for testing)
# Replace these with your actual Square tokens from the Developer Dashboard (https://developer.squareup.com)

SQUARE_ENVIRONMENT=Sandbox
SQUARE_ACCESS_TOKEN=sandbox-sq0atb-YOUR_SANDBOX_ACCESS_TOKEN

# If deploying alongside jarin.dev, set the allowed frontend origin
# FRONTEND_URL=https://jarin.dev

# Port for the Node backend
PORT=3000
